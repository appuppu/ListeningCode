<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.listeningcode.generate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
        <string>/Applications/Xcode.app/Contents/Developer/usr/bin/python3</string>
        <string>/Users/fukushimatakumi/develop/listeningcode/scripts/generate_all.py</string>
    </array>

    <!-- Every 10 minutes -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>/Users/fukushimatakumi/develop/listeningcode/scripts/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fukushimatakumi/develop/listeningcode/scripts/logs/stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/fukushimatakumi/develop/listeningcode/scripts</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/share/google-cloud-sdk/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
